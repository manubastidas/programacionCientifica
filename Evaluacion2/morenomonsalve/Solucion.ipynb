        "import numpy as np\n",
        "import jax.numpy as jnp\n",
        "\n",
        "# Cargar los datos\n",
        "datos = np.load(\"datos_3430.npz\")\n",
        "\n",
        "# Extraer las señales\n",
        "X = jnp.array(datos['X'])\n",
        "\n",
        "y = jnp.array(datos['y'])\n",
        "\n",
        "print(f\"Forma de los datos X: {X.shape}\")\n",
        "print(f\"Forma de las etiquetas y: {y.shape}\")"
      ]
    }
